{
  "expo": {
    "name": "PINAK",
    "slug": "pinak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "Pinak.Ethereal.com",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "Pinak.Ethereal.com",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "pinak",
    "extra": {
      "firebaseApiKey": "REEMPLAZA_CON_TU_API_KEY",
      "firebaseAuthDomain": "pinak-cd2e4.firebaseapp.com",
      "firebaseProjectId": "pinak-cd2e4",
      "firebaseStorageBucket": "pinak-cd2e4.firebasestorage.app",
      "firebaseMessagingSenderId": "47882058149",
      "firebaseAppId": "REEMPLAZA_CON_TU_APP_ID",
      "googleIosClientId": "REEMPLAZA_CON_TU_IOS_CLIENT_ID",
      "googleAndroidClientId": "REEMPLAZA_CON_TU_ANDROID_CLIENT_ID",
      "googleWebClientId": "REEMPLAZA_CON_TU_WEB_CLIENT_ID"
    }
  }
}
