# Copia este archivo a functions/.env (o .env.pinak-dev) y ajusta. NO subas el .env real.

# Modelo de Gemini (por defecto gemini-3.6-flash). Revisa las fechas de retiro antes de cambiarlo:
# https://ai.google.dev/gemini-api/docs/deprecations
# GEMINI_MODEL=gemini-3.6-flash

# Exige App Check en las funciones. Actívalo solo cuando web y móvil envíen tokens de App Check.
# APP_CHECK_ENFORCE=true
