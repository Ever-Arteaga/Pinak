{
  "name": "functions",
  "description": "Cloud Functions para PINAK (registro por IA, Fase 3)",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run",
    "backfill": "tsx scripts/backfillSummaries.ts"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "private": true
}
