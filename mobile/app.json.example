{
  "expo": {
    "name": "PINAK",
    "slug": "pinak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ethereal.pinak",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.ethereal.pinak",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#10123a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "pinak",
    "extra": {
      "firebaseApiKey": "REEMPLAZA_CON_TU_API_KEY",
      "firebaseAuthDomain": "pinak-dev.firebaseapp.com",
      "firebaseProjectId": "pinak-dev",
      "firebaseStorageBucket": "pinak-dev.firebasestorage.app",
      "firebaseMessagingSenderId": "REEMPLAZA_CON_TU_MESSAGING_SENDER_ID",
      "firebaseAppId": "REEMPLAZA_CON_TU_APP_ID",
      "googleIosClientId": "REEMPLAZA_CON_TU_IOS_CLIENT_ID",
      "googleAndroidClientId": "REEMPLAZA_CON_TU_ANDROID_CLIENT_ID",
      "googleWebClientId": "REEMPLAZA_CON_TU_WEB_CLIENT_ID",
      "boldRedirectUrl": "https://pinak-dev.web.app/upgrade/procesando/"
    }
  }
}
